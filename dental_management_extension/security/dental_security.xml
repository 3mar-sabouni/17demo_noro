<odoo>
    <record id="group_reception_one" model="res.groups">
        <field name="name">Reception One</field>
    </record>

    <record id="group_reception_two" model="res.groups">
        <field name="name">Reception Two</field>
    </record>

    <record id="group_reception_main" model="res.groups">
        <field name="name">Reception Main</field>
    </record>

    <record id="medical_appointment_doctor_rule" model="ir.rule">
        <field name="name">Appointment: Doctor's Appointments Only</field>
        <field name="model_id" ref="pragtech_dental_management.model_medical_appointment"/>
        <field name="domain_force">[('doctor', 'in', user.doctor_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/> <!-- or a specific group if you want -->
    </record>

    <!-- Reception One: Restrict access but allow creation -->
    <record id="appointment_rule_reception_one" model="ir.rule">
        <field name="name">Reception One: Own Records</field>
        <field name="model_id" ref="pragtech_dental_management.model_medical_appointment"/>
        <field name="groups" eval="[(4, ref('dental_management_extension.group_reception_one'))]"/>
        <field name="domain_force">['|', ('created_by_group', '=', 'one'), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Reception Two: Restrict access but allow creation -->
    <record id="appointment_rule_reception_two" model="ir.rule">
        <field name="name">Reception Two: Own Records</field>
        <field name="model_id" ref="pragtech_dental_management.model_medical_appointment"/>
        <field name="groups" eval="[(4, ref('dental_management_extension.group_reception_two'))]"/>
        <field name="domain_force">['|', ('created_by_group', '=', 'two'), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- Reception Main can see all appointments -->
    <record id="appointment_rule_reception_main" model="ir.rule">
        <field name="name">Reception Main: See All</field>
        <field name="model_id" ref="pragtech_dental_management.model_medical_appointment"/>
        <field name="groups" eval="[(4, ref('dental_management_extension.group_reception_main'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
