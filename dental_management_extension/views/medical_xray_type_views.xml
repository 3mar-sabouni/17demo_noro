<odoo>
    <!-- Tree View for X-Ray Type -->
    <record id="view_medical_xray_type_tree" model="ir.ui.view">
        <field name="name">medical.xray.type.tree</field>
        <field name="model">medical.xray.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View for X-Ray Type -->
    <record id="view_medical_xray_type_form" model="ir.ui.view">
        <field name="name">medical.xray.type.form</field>
        <field name="model">medical.xray.type</field>
        <field name="arch" type="xml">
            <form string="X-Ray Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for X-Ray Type -->
    <record id="action_medical_xray_type" model="ir.actions.act_window">
        <field name="name">X-Ray Types</field>
        <field name="res_model">medical.xray.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first X-Ray Type
            </p>
        </field>
    </record>

        <menuitem
            id="medical_xray_types"
            name="Medical X-Ray Types"
            action="action_medical_xray_type"
            parent="pragtech_dental_management.medical_conf_menu"
            />
</odoo>
