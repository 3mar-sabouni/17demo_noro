<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_analytic" model="ir.ui.view">
        <field name="name">account.payment.form.analytic.distribution</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="Analytic">
                    <field name="analytic_distribution" widget="analytic_distribution"
                           groups="analytic.group_analytic_accounting" 
                           context="{'default_company_id': company_id}" required="1"/>
                    <field name="analytic_apply_on" groups="analytic.group_analytic_accounting"/>

                </group>

            </xpath>

        </field>
    </record>

    <!-- Extend Register Payment Wizard -->
    <record id="view_account_payment_register_form_analytic" model="ir.ui.view">
        <field name="name">account.payment.register.form.analytic.distribution</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Analytic">
                    <field name="analytic_distribution" widget="analytic_distribution"
                           groups="analytic.group_analytic_accounting"
                           context="{'default_company_id': company_id}" required="1"/>
                    <field name="analytic_apply_on" groups="analytic.group_analytic_accounting"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
